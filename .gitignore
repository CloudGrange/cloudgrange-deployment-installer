compose/.env
*.env
!*.env.example

# Claude Code local settings (logs and machine-local overrides only)
.claude/logs/
.claude/settings.local.json

# Python bytecode caches: the merge gate runs the python suites in-tree (some as root), so
# these appear on every run and were being committed by accident; two branches that both ran
# the gate then conflict on binary .pyc files.
__pycache__/
*.py[cod]
