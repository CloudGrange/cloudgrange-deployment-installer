# CloudGrange Standalone Compose — Required Environment Variables
# Copy this file to .env and fill in all <change-me> values before running.
# NEVER commit the .env file — it is listed in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cloudgrange
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=cloudgrange

# Full Npgsql connection string — uses POSTGRES_PASSWORD above
CLOUDGRANGE_DB_CONNECTION=Host=postgres;Database=cloudgrange;Username=cloudgrange;Password=<change-me>

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<change-me>

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=<change-me>

# Confidential client secret for cloudgrange-api (set in Keycloak admin → Clients → cloudgrange-api → Credentials)
CLOUDGRANGE_KEYCLOAK_CLIENT_SECRET=<change-me>

# ── cloudgrange-api ────────────────────────────────────────────────────────────
CLOUDGRANGE_KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/cloudgrange
CLOUDGRANGE_KEYCLOAK_CLIENT_ID=cloudgrange-api
CLOUDGRANGE_OTLP_ENDPOINT=http://otel-collector:4317

# ── cloudgrange-relay ──────────────────────────────────────────────────────────
# Shared enrollment token that Agents use to register with the Relay.
# Generate a random secret: openssl rand -hex 32
RELAY_ENROLLMENT_TOKEN=<change-me>

# ── Public URL (used by portal to locate the API) ─────────────────────────────
# Set this to the externally-reachable URL of cloudgrange-api (port 8081 by default).
CLOUDGRANGE_PUBLIC_URL=http://localhost:8081

# ── CloudGrange version pinning ────────────────────────────────────────────────
CLOUDGRANGE_VERSION=0.1.0
