# CloudGrange Standalone Compose — Required Environment Variables
# Copy this file to .env and fill in all <change-me> values before running.
# NEVER commit the .env file — it is listed in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cloudgrange
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=cloudgrange

# Full Npgsql connection string — uses POSTGRES_PASSWORD above
CLOUDGRANGE_DB_CONNECTION=Host=postgres;Database=cloudgrange;Username=cloudgrange;Password=<change-me>

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<change-me>

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=<change-me>

# Confidential client secret for cloudgrange-api. Substituted into the realm import and passed to
# the API as Keycloak__ClientSecret (compose requires this exact name).
KEYCLOAK_API_CLIENT_SECRET=<change-me>

# Temporary password of the first CloudGrange realm administrator (admin@cloudgrange.local,
# PlatformAdmin), created by keycloak/bootstrap-realm-admin.sh. Must be changed at first sign-in.
CLOUDGRANGE_REALM_ADMIN_PASSWORD=<change-me>

# Public host name or IP of this VM. Keycloak's issuer and the portal client's only allowed redirect
# URI / web origin are derived from it (https://<CLOUDGRANGE_HOSTNAME>/).
CLOUDGRANGE_HOSTNAME=<change-me>

# ── cloudgrange-api ────────────────────────────────────────────────────────────
CLOUDGRANGE_KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/cloudgrange
CLOUDGRANGE_KEYCLOAK_CLIENT_ID=cloudgrange-api
CLOUDGRANGE_OTLP_ENDPOINT=http://otel-collector:4317

# ── cloudgrange-relay ──────────────────────────────────────────────────────────
# Shared enrollment token that Agents use to register with the Relay.
# Generate a random secret: openssl rand -hex 32
RELAY_ENROLLMENT_TOKEN=<change-me>

# ── Public URL ────────────────────────────────────────────────────────────────
# The API has no host port; everything public goes through nginx TLS on 443.
CLOUDGRANGE_PUBLIC_URL=https://<change-me>

# ── CloudGrange version pinning ────────────────────────────────────────────────
CLOUDGRANGE_VERSION=0.1.0
