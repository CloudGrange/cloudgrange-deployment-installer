# CloudSmith Standalone Compose — Required Environment Variables
# Copy this file to .env and fill in all <change-me> values before running.
# NEVER commit the .env file — it is listed in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cloudsmith
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=cloudsmith

# Full Npgsql connection string — uses POSTGRES_PASSWORD above
CLOUDSMITH_DB_CONNECTION=Host=postgres;Database=cloudsmith;Username=cloudsmith;Password=<change-me>

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<change-me>

# Confidential client secret for cloudsmith-api (set in Keycloak admin → Clients → cloudsmith-api → Credentials)
CLOUDSMITH_KEYCLOAK_CLIENT_SECRET=<change-me>

# ── cloudsmith-api ────────────────────────────────────────────────────────────
CLOUDSMITH_KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/cloudsmith
CLOUDSMITH_KEYCLOAK_CLIENT_ID=cloudsmith-api
CLOUDSMITH_OTLP_ENDPOINT=http://otel-collector:4317

# ── CloudSmith version pinning ────────────────────────────────────────────────
CLOUDSMITH_VERSION=0.1.0
