# CloudSmith Standalone Compose — local dev environment (gitignored, NEVER commit)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cloudsmith
POSTGRES_PASSWORD=CloudSmith-Pg-Dev-2026!
POSTGRES_DB=cloudsmith
CLOUDSMITH_DB_CONNECTION=Host=postgres;Database=cloudsmith;Username=cloudsmith;Password=CloudSmith-Pg-Dev-2026!

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CloudSmith-Kc-Dev-2026!
CLOUDSMITH_KEYCLOAK_CLIENT_SECRET=cloudsmith-api-dev-secret-2026

# ── cloudsmith-api ────────────────────────────────────────────────────────────
CLOUDSMITH_KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/cloudsmith
CLOUDSMITH_KEYCLOAK_CLIENT_ID=cloudsmith-api
CLOUDSMITH_OTLP_ENDPOINT=http://otel-collector:4317

# ── CloudSmith version pinning (images pushed as :latest from main) ───────────
CLOUDSMITH_VERSION=latest
