# AB#8129 — appliance operator access: publish the one-use setup token, temporary realm admin password
# and operator SSH key to Hyper-V KVP and the local console until setup completes, then remove them.
[Unit]
Description=CloudGrange appliance operator access (KVP and local console until setup completes)
ConditionPathExists=!/etc/cloudgrange/operator-access-cleared
# After the rotation ceiling nothing is published until an administrator re-arms (docs/appliance-operator-access.md).
ConditionPathExists=!/etc/cloudgrange/operator-access-stale
Requires=cloudgrange.service
Wants=hv-kvp-daemon.service cloudgrange-realm-admin.service
After=cloudgrange.service cloudgrange-realm-admin.service hv-kvp-daemon.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/cloudgrange-operator-access.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
